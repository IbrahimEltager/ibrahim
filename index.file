        // Theme configuration
        window.currentTheme = {"brand":{"accent":"#38BDF8","neutral":{"100":"#FFFFFF","900":"#0B0B0B"},"primary":"#1DA1F2","secondary":"#0F172A","font_family":"\u0027Inter\u0027, sans-serif"},"modes":{"dark":{"color":{"card":"#141414","text":{"primary":"#FFFFFF","secondary":"#9CA3AF"},"border":"#262626","surface":"#141414","background":"#0B0B0B"}},"light":{"color":{"card":"#FFFFFF","text":{"primary":"#0B0B0B","secondary":"#6B7280"},"border":"#E5E7EB","surface":"#F5F7FA","background":"#FFFFFF"}}}};
        window.currentTenant = '216bf062-e01d-440e-a9d9-257e97ab25eb';
        window.currentThemeTokens = {"brand":{"accent":"#38BDF8","neutral":{"100":"#FFFFFF","900":"#0B0B0B"},"primary":"#1DA1F2","secondary":"#0F172A","font_family":"\u0027Inter\u0027, sans-serif"},"semantic":{"color":{"button":{"primary":{"bg":"#1DA1F2","text":"#ffffff"},"secondary":{"bg":"#0F172A","text":"#ffffff"}},"card":"#FFFFFF","text":{"primary":"#0B0B0B","secondary":"#6B7280"},"border":"#E5E7EB","surface":"#F5F7FA","background":"#FFFFFF"}}};
        (function() {
            try {
                const storedMode = localStorage.getItem('theme-mode');
                const fallbackMode = 'light';
                const mode = ['light', 'dark'].includes(storedMode) ? storedMode : fallbackMode;
                const html = document.documentElement;
                html.dataset.theme = mode;
                if (mode === 'dark') {
                    html.classList.add('dark');
                } else {
                    html.classList.remove('dark');
                }
                window.initialThemeMode = mode;
            } catch (error) {
                window.initialThemeMode = 'light';
            }
        })();
    </script>

        <style>
        .certificate-page {
            --success-color: #059669;
            --success-hover: #047857;
            --error-color: #dc2626;
            --error-hover: #b91c1c;
            --warning-color: #d97706;
            --primary-color: var(--color-button-primary-bg, #2563eb);
            --primary-hover: var(--color-button-primary-hover, var(--primary-color));
            --primary-text-color: var(--color-button-primary-text, #ffffff);
            --neutral-50: #f9fafb;
            --neutral-100: #f3f4f6;
            --neutral-200: #e5e7eb;
            --neutral-600: #4b5563;
            --neutral-700: #374151;
            --neutral-800: #1f2937;
            --neutral-900: #111827;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
            --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);

            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            min-height: 100vh;
        }

        .academy-logo {
            width: 120px;
            height: 120px;
            object-fit: contain;
            filter: drop-shadow(var(--shadow-sm));
            transition: transform 0.3s ease;
        }

        .academy-logo:hover {
            transform: scale(1.05);
        }

        .verification-icon {
            background: var(--primary-color);
            color: white;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-lg);
            animation: fadeInScale 0.6s ease-out;
        }

        .card {
            background: white;
            border-radius: 24px;
            box-shadow: var(--shadow-xl);
            border: 1px solid var(--neutral-200);
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .card:hover {
            box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.15);
            transform: translateY(-2px);
        }

        .success-header {
            background: var(--success-color);
            color: white;
            padding: 3rem 2rem;
            text-align: center;
            position: relative;
        }

        .error-header {
            background: var(--error-color);
            color: white;
            padding: 3rem 2rem;
            text-align: center;
            position: relative;
        }

        .status-icon {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            box-shadow: var(--shadow-md);
        }

        .success-icon {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
        }

        .error-icon {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
        }

        .detail-item {
            background: var(--neutral-50);
            border: 1px solid var(--neutral-200);
            border-radius: 16px;
            padding: 1.5rem;
            transition: all 0.2s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .detail-item:hover {
            background: var(--neutral-100);
            border-color: var(--primary-color);
            transform: translateX(-4px);
        }

        .detail-label {
            font-weight: 600;
            color: var(--neutral-700);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .detail-value {
            font-weight: 500;
            color: var(--neutral-900);
            text-align: right;
            flex: 1;
        }

        .dot-indicator {
            width: 8px;
            height: 8px;
            background: var(--primary-color);
            border-radius: 50%;
            flex-shrink: 0;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 1rem 2rem;
            font-weight: 600;
            border-radius: 16px;
            text-decoration: none;
            transition: all 0.2s ease;
            border: 2px solid transparent;
            cursor: pointer;
            gap: 0.5rem;
            box-shadow: var(--shadow-md);
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .btn-primary {
            background: var(--primary-color);
            color: var(--primary-text-color);
        }

        .btn-primary:hover {
            background: var(--primary-hover);
            color: var(--primary-text-color);
        }

        .btn-secondary {
            background: var(--neutral-700);
            color: white;
        }

        .btn-secondary:hover {
            background: var(--neutral-800);
            color: white;
        }

        .btn-linkedin {
            background: #0077B5;
            color: white;
            border-color: #0077B5;
        }

        .btn-linkedin:hover {
            background: #006399;
            border-color: #006399;
            color: white;
        }

        .btn-linkedin svg {
            fill: currentColor;
        }

        .info-point {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            text-align: right;
        }

        .info-point-dot {
            width: 6px;
            height: 6px;
            background: var(--error-color);
            border-radius: 50%;
            margin-top: 0.5rem;
            flex-shrink: 0;
        }

        .warning-box {
            background: #fef3c7;
            border: 1px solid #fde68a;
            border-radius: 16px;
            padding: 1.5rem;
            margin-top: 2rem;
        }

        .help-section {
            background: white;
            border: 1px solid var(--neutral-200);
            border-radius: 16px;
            padding: 1rem 1.5rem;
            box-shadow: var(--shadow-sm);
            transition: all 0.2s ease;
        }

        .help-section:hover {
            box-shadow: var(--shadow-md);
            border-color: var(--primary-color);
        }

        @keyframes fadeInScale {
            from {
                opacity: 0;
                transform: scale(0.8);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-slide-up {
            animation: slideInUp 0.6s ease-out;
        }

        @media (max-width: 640px) {
            .academy-logo {
                width: 80px;
                height: 80px;
            }

            .verification-icon {
                width: 60px;
                height: 60px;
            }

            .detail-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }

            .detail-value {
                text-align: right;
                width: 100%;
            }
        }

        /* Focus states for accessibility */
        .btn:focus,
        .detail-item:focus {
            outline: 2px solid var(--primary-color);
            outline-offset: 2px;
        }

        /* High contrast mode support */
        @media (prefers-contrast: high) {
            .card {
                border: 2px solid var(--neutral-800);
            }

            .detail-item {
                border: 2px solid var(--neutral-400);
            }
        }
    </style>
</head>

<body x-data="{
    page: 'Certificate Verification',
    loaded: true,
    darkMode: $persist(window.initialThemeMode === 'dark'),
    stickyMenu: false,
    sidebarToggle: false,
    scrollTop: false
}" x-init="const syncFromThemeManager = (event) => {
    const isDark = event.detail?.mode === 'dark';
    if (typeof isDark === 'boolean' && darkMode !== isDark) {
        darkMode = isDark;
    }
};

window.addEventListener('theme-mode-updated', syncFromThemeManager);
if (window.initialThemeMode) {
    syncFromThemeManager({ detail: { mode: window.initialThemeMode } });
}

$watch('darkMode', value => {
    const desiredMode = value ? 'dark' : 'light';
    localStorage.setItem('darkMode', JSON.stringify(value));
    if (window.themeManager && window.themeManager.currentMode !== desiredMode) {
        window.themeManager.setMode(desiredMode);
    }
});" x-bind:data-theme="darkMode ? 'dark' : 'light'"
